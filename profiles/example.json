{
  "_comment": [
    "最小可用示例域。用 extends 继承 base.json 的公共配置，只写差异：",
    "  · sources / layers —— 本域特有",
    "  · paths —— 输出到 tests/fixtures/（示例域不污染 references/）",
    "  · verify.probes / generic_fill / legacy_shelf —— list 整体替换",
    "  · verify.thresholds —— dict 递归合并（只覆盖 recall_name 一项）",
    "查看合并结果：seedbrain config --show --profile profiles/example.json"
  ],
  "extends": "base.json",
  "name": "example",
  "label": "示例方法库",
  "sources": [
    {
      "kind": "table",
      "path": "tests/fixtures/mini-domain/tools.md",
      "layer": "tool",
      "group_re": "^##\\s+(?P<group>[^#].*)$",
      "entry_re": "^-\\s*\\*\\*(?P<name>[^*]+?)\\*\\*\\s*·\\s*(?P<tag>[^—]+?)\\s*——\\s*(?P<desc>.+)$"
    },
    {
      "kind": "card",
      "dir": "tests/fixtures/mini-domain/cards",
      "layer": "card",
      "title_re": "^#\\s+(?P<title>.+)$",
      "field_re": "^>\\s*\\*\\*(?P<key>[^*]+?)\\*\\*\\s*[：:]\\s*(?P<val>.*)$",
      "list_re": "^>\\s*(?:[-*]|\\d+\\.)\\s+(?P<item>.+)$",
      "template_parts": ["card"]
    }
  ],
  "layers": {
    "tool": { "prefix": "tl", "quota": 0.6, "label": "方法条目" },
    "card": { "prefix": "cd", "quota": 0.4, "label": "专题卡" }
  },
  "paths": {
    "index_jsonl": "tests/fixtures/mini-domain/seed-index.jsonl",
    "index_md": "tests/fixtures/mini-domain/SEED-INDEX.md",
    "additions": "tests/fixtures/mini-domain/seed-additions.jsonl",
    "state": "tests/fixtures/mini-domain/.seed-usage.json"
  },
  "verify": {
    "probes": [
      "降维压缩，矩阵分解选型",
      "最短路径与连通分量",
      "非平稳信号的时频分析",
      "采样率不足导致混叠"
    ],
    "generic_fill": ["方法", "计算", "结果", "分析"],
    "legacy_shelf": ["tl-矩阵分解", "tl-图遍历"],
    "thresholds": {
      "recall_name": 0.9
    }
  }
}
