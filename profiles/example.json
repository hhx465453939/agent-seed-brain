{
  "_comment": [
    "最小可用示例域。",
    "extends → \"builtin:base\"：公共 norms / paths / thresholds 来自 SDK 包内",
    "  seedbrain/data/base.json（随版本走，零复制）。",
    "probes_ref → \"builtin:probes/core\"：公共探针池（8 条通用任务）在前，",
    "  本域 probes（4 条）在后拼接；不要用 extends 继承探针，因为 list 是整体替换。",
    "查看合并结果：seedbrain config --profile profiles/example.json"
  ],
  "extends": "builtin:base",
  "name": "example",
  "label": "示例方法库",
  "sources": [
    {
      "kind": "table",
      "path": "tests/fixtures/mini-domain/tools.md",
      "layer": "tool",
      "group_re": "^##\\s+(?P<group>[^#].*)$",
      "entry_re": "^-\\s*\\*\\*(?P<name>[^*]+?)\\*\\*\\s*·\\s*(?P<tag>[^—]+?)\\s*——\\s*(?P<desc>.+)$"
    },
    {
      "kind": "card",
      "dir": "tests/fixtures/mini-domain/cards",
      "layer": "card",
      "title_re": "^#\\s+(?P<title>.+)$",
      "field_re": "^>\\s*\\*\\*(?P<key>[^*]+?)\\*\\*\\s*[：:]\\s*(?P<val>.*)$",
      "list_re": "^>\\s*(?:[-*]|\\d+\\.)\\s+(?P<item>.+)$",
      "template_parts": ["card"]
    }
  ],
  "layers": {
    "tool": { "prefix": "tl", "quota": 0.6, "label": "方法条目" },
    "card": { "prefix": "cd", "quota": 0.4, "label": "专题卡" }
  },
  "paths": {
    "index_jsonl": "tests/fixtures/mini-domain/seed-index.jsonl",
    "index_md": "tests/fixtures/mini-domain/SEED-INDEX.md",
    "additions": "tests/fixtures/mini-domain/seed-additions.jsonl",
    "state": "tests/fixtures/mini-domain/.seed-usage.json"
  },
  "verify": {
    "probes_ref": "builtin:probes/core",
    "probes": [
      "降维压缩，矩阵分解选型",
      "最短路径与连通分量",
      "非平稳信号的时频分析",
      "采样率不足导致混叠"
    ],
    "generic_fill": ["方法", "计算", "结果", "分析"],
    "legacy_shelf": ["tl-矩阵分解", "tl-图遍历"],
    "thresholds": {
      "recall_name": 0.9
    }
  }
}
